{
  "version": 2,
  "builds": [
    {
      "src": "courier-backend/src/server.js",
      "use": "@vercel/node@3",
      "config": {
        "includeFiles": ["courier-backend/src/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "courier-backend/src/server.js"
    }
  ]
}

{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node@3",
      "config": {
        "includeFiles": [
          "src/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://subak-raftar-server.vercel.app/api/:path*"
    }
  ]
}